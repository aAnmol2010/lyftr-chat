# Copy to .env. Replace both values with valid server-side credentials.
LLM_API_KEYS=
LLM_MODEL=gemini/gemini-3.5-flash-lite
DATABASE_URL=sqlite:////data/app.db
ALLOWED_ORIGINS=http://localhost:3000
ENABLE_FAILURE_SIMULATION=true
MAX_HISTORY_TURNS=20
DEFAULT_SYSTEM_PROMPT="You are a helpful assistant. Answer clearly and concisely."
VITE_API_BASE_URL=http://localhost:8000
# Backend HTTP port on a hosting platform (Compose maps the default).
PORT=8000
# Optional local browser test executable.
CHROME_PATH=
# Optional override if port 3000 is already occupied. Update ALLOWED_ORIGINS too.
FRONTEND_PORT=3000
# Optional deployed frontend URL for the independent full-stack browser test.
STACK_URL=
# Local published backend port. Set VITE_API_BASE_URL to match any override.
BACKEND_PORT=8000
